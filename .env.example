# Local Docker Compose — copy to .env and fill in values.
# Generate hash:  python3 scripts/generate-password-hash.py
# Generate secret: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# Required for docker compose up (see compose.yaml)
# In .env, escape each $ in the hash as $$ (Compose variable interpolation)
FAMILY_APP_PASSWORD_HASH=
FAMILY_AUTH_SECRET=

# Local HTTP: leave false. Production behind HTTPS: true
FAMILY_AUTH_COOKIE_SECURE=false

# Host port mapped to container 8080 (default 8080)
APP_PORT=8080

# Optional: browser smoke test password (must match hash above)
# HOSTING_TEST_PASSWORD=

# Optional: Gemini narration for Coach answers (Docker + local hosting)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
