{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,dist/**,src/**,public/**,tests/**,scripts/**,specs/**,docs/**,.git/**,.env*,agents/**/memory/**,agents/**/tests/**,agents/**/.env*}"
    }
  },
  "rewrites": [
    { "source": "/agent-api/:path*", "destination": "/api" },
    { "source": "/coach", "destination": "/index.html" },
    { "source": "/week", "destination": "/index.html" },
    { "source": "/setup", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/agent-api/:path*", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
