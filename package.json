{
  "name": "family-task-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:hosting:browser": "node scripts/hosting-smoke.mjs",
    "hosting:docker": "docker compose up --build",
    "test:agent": "python3 -m pytest agents/homework-coach-agent/tests -q",
    "coach:api": "python3 agents/homework-coach-agent/api/main.py",
    "coach:ui": "python3 agents/homework-coach-agent/ui/app.py"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  }
}
